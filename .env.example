# ============================================================
# DuoBot Campus - variables de entorno (SIN valores secretos)
# Copia este archivo a .env y llena los valores. NUNCA subas .env
# ============================================================

# --- Postgres local (docker-compose) ---
POSTGRES_USER=duobot
POSTGRES_PASSWORD=cambia_esto
POSTGRES_PORT=5432

# --- MongoDB local (segunda base; cambiar si el equipo elige otro motor) ---
MONGO_PORT=27017

# --- URLs de bases por proyecto (servicios MCP) ---
ESTUDIANTES_DATABASE_URL=postgresql+psycopg://duobot:cambia_esto@localhost:5432/duobot_estudiantes_app
ESTUDIANTES_MONGO_URL=mongodb://localhost:27017/duobot_estudiantes_analytics
ADMIN_DATABASE_URL=postgresql+psycopg://duobot:cambia_esto@localhost:5432/duobot_admin_app
ADMIN_MONGO_URL=mongodb://localhost:27017/duobot_admin_analytics

# --- Supabase (solo autenticacion) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Stripe (modo prueba) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# --- CORS: URL del frontend permitido ---
ESTUDIANTES_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# --- Hosts permitidos por el servidor MCP (produccion: dominio de Railway/Render) ---
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# --- Modelo de Claude para el chat (opcional; hay un valor por defecto) ---
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- URL del MCP propio, solo si el chat no debe usar http://127.0.0.1:$PORT/mcp ---
MCP_INTERNAL_URL=
